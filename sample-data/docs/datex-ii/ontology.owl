	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy-other"/>
