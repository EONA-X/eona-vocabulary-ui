		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Facilities Rates; external, out of scope).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The pricing/rates applicable to this energy mix.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Energy mix rates</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
