	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/minimumDeliveryAmount">
		<source xmlns="http://purl.org/dc/terms/">DATEX II RefillPoint.minimumDeliveryAmount; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:decimal. DATEX II native type: Units (float).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/RefillPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The minimum amount of energy/fuel that can be delivered in a single session, in the unit given by datex:deliveryUnit.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Minimum delivery amount</prefLabel>
