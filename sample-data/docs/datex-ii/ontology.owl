		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: enumeration (DieselTypeEnum) — see narrower code values. Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/DieselRefillPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The type(s) of diesel fuel dispensed (e.g. car diesel, truck diesel, biodiesel).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Diesel type</prefLabel>
