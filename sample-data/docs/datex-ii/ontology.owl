	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/energyInfrastructureStation">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureSite.energyInfrastructureStation; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II EnergyInfrastructureStation) — see the EnergyInfrastructureStation entity. Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The energy infrastructure station(s) located on this site. The containment edge from Site down to Station.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Energy infrastructure station (containment)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/exit">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureSite.exit; hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Location; external, out of scope — see the pre-existing datex:entrance for the same pattern). Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The geographic location of an exit from the site.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Exit</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/preferredUsers">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureSite.preferredUsers (fac:_UserTypeEnum, DATEX II Facilities namespace); hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: enumeration (DATEX II Facilities UserTypeEnum; external, out of scope — code values not modelled). Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The user group(s) for whom this site is preferentially intended (non-exclusive). External enumeration (DATEX II Facilities UserTypeEnum) — code values are not modelled in this hub-curated subset (out of scope, Facilities namespace).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Preferred users</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/exclusiveUsers">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureSite.exclusiveUsers (fac:_UserTypeEnum, DATEX II Facilities namespace); hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: enumeration (DATEX II Facilities UserTypeEnum; external, out of scope — code values not modelled). Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The user group(s) exclusively allowed to use this site (e.g. employees, hotel guests). External enumeration (DATEX II Facilities UserTypeEnum) — code values are not modelled in this hub-curated subset (out of scope, Facilities namespace).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Exclusive users</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureSite"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/typeOfSite-other">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">other</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
