	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/refillPoint">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureStation.refillPoint; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/RefillPoint"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II RefillPoint) — see the RefillPoint entity and its specialisations. Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A refill point of this station, embedded inline. The containment edge from Station down to RefillPoint (and its specialisations, e.g. ElectricVehicleChargingPoint).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refill point (containment)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/stationServiceType">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureStation.serviceType; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ServiceType"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II ServiceType) — see the ServiceType entity.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The way the station&apos;s refill points are serviced (full service, self-service, or unattended).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Station service type</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/energyDistributor">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureStation.energyDistributor; hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Organisation; external, out of scope — same pattern as the pre-existing datex:energyProvider).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The organisation distributing the energy at the station (as distinct from the energy provider/producer).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Energy distributor</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/userInterfaceLanguage">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureStation.userInterfaceLanguage; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:language. DATEX II native type: Language (ISO 639-1 code). Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A language supported by the station&apos;s user interface / payment terminal.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">User interface language</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/refillPointByReference">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureStation.refillPointByReference; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/RefillPoint"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II VersionedReference targeting a RefillPoint) — see the RefillPoint entity. Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A refill point of this station, referenced by identifier rather than embedded inline (e.g. one already published separately).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refill point (by reference)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/numberOfRefillPoints">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructureStation.numberOfRefillPoints; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:nonNegativeInteger. DATEX II native type: NonNegativeInteger.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The number of refill points (e.g. charging points) available at the station.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Number of refill points</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
