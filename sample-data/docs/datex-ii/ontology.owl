		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/connectorType">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-other"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-teslaS"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-teslaR"/>
