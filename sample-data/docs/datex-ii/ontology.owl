		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Priced per unit of charging time.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Price per charging time</prefLabel>
