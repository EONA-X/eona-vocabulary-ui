<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/sourceRatioValue">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricEnergySourceRatio.sourceRatioValue; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:decimal (percentage). DATEX II native type: PercentageValue. Required in DATEX II.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The percentage share of this energy source within the electric energy mix.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Source ratio value</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/otherEnergySource">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricEnergySourceRatio.otherEnergySource; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:string. DATEX II native type: String.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Free-text description of the energy source when datex:energySource is &apos;other&apos;.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Other energy source (free text)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/energySource">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricEnergySourceRatio.energySource (ElectricEnergySourceTypeEnum); hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energySourceType"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: enumeration (DATEX II ElectricEnergySourceTypeEnum) — reuses the pre-existing datex:energySourceType enumeration (see its narrower code values). Required in DATEX II.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The type of energy source for this source/ratio pairing. Reuses the pre-existing datex:energySourceType enumeration root (ElectricEnergySourceTypeEnum) as its range rather than duplicating its 10 code values under a new IRI.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Energy source</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/sourceRatioValue"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/otherEnergySource"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energySource"/>
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructure: ElectricEnergySourceRatio; hub-curated SKOS rendering.</source>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A single energy-source/ratio pairing within an electric energy mix (e.g. &apos;40% solar&apos;). Referenced by the pre-existing ElectricEnergyMix entity via the new datex:electricEnergySourceRatio containment attribute; provides a fully faithful, properly-nested alternative to that entity&apos;s pre-existing flattened datex:energySourceType/datex:energySourceRatio attributes.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Electric energy source ratio</prefLabel>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/bikeParkingCapacity">
		<source xmlns="http://purl.org/dc/terms/">DATEX II AssociatedParking.bikeParkingCapacity; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:nonNegativeInteger. DATEX II native type: NonNegativeInteger.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/AssociatedParking"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The number of bike parking places in the associated parking.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Bike parking capacity</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/AssociatedParking"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/truckParkingCapacity">
		<source xmlns="http://purl.org/dc/terms/">DATEX II AssociatedParking.truckParkingCapacity; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:nonNegativeInteger. DATEX II native type: NonNegativeInteger.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/AssociatedParking"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The number of truck parking places in the associated parking.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Truck parking capacity</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/AssociatedParking"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/carParkingCapacity">
		<source xmlns="http://purl.org/dc/terms/">DATEX II AssociatedParking.carParkingCapacity; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:nonNegativeInteger. DATEX II native type: NonNegativeInteger.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/AssociatedParking"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The number of car parking places in the associated parking.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Car parking capacity</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/AssociatedParking"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/AssociatedParking">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/bikeParkingCapacity"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/truckParkingCapacity"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/carParkingCapacity"/>
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructure: AssociatedParking (extends Facilities AssociatedFacility); hub-curated SKOS rendering.</source>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Parking capacity associated with an energy infrastructure facility, broken down by vehicle class.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Associated parking</prefLabel>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/additionalInformation">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyPricingPolicy.additionalInformation; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:string. DATEX II native type: MultilingualString.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Free-text additional information about the pricing policy.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Additional information</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/minimumDeliveryFee">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyPricingPolicy.minimumDeliveryFee; hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Facilities AmountOfMoney; external, out of scope).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The minimum fee charged for a delivery under this pricing policy.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Minimum delivery fee</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/maximumDeliveryFee">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyPricingPolicy.maximumDeliveryFee; hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Facilities AmountOfMoney; external, out of scope).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The maximum fee charged for a delivery under this pricing policy.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Maximum delivery fee</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/discount">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyPricingPolicy.discount; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:decimal (percentage). DATEX II native type: Percentage (float).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A discount percentage applied to the energy price.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Discount</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/combinationWithParkingFee">
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyPricingPolicy.combinationWithParkingFee; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:boolean. DATEX II native type: Boolean.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Whether the energy price is combined with a parking fee.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Combination with parking fee</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyPricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy-other">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">other</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A pricing policy not covered by the enumerated values.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Other pricing policy</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy-free">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">free</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The energy is provided free of charge.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Free</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy-unknown">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">unknown</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The pricing policy is unknown.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Unknown pricing policy</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy-flatRate">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">flatRate</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A flat rate applies.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Flat rate</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy"/>
