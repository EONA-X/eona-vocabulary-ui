		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy-contract">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">contract</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Priced according to a contract.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Contract</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy"/>
