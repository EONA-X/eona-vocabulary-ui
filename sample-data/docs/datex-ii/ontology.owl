		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Organisation; external, out of scope — same pattern as the pre-existing datex:energyProvider).</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The organisation providing this specific energy mix.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Energy mix provider</prefLabel>
