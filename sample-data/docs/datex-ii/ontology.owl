	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/pricingPolicy-pricePerDeliveryUnit">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">pricePerDeliveryUnit</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Priced per delivery unit (e.g. per kWh, per litre).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Price per delivery unit</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/pricingPolicy"/>
