		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/notAvailable">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricEnergyMix.notAvailable; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:boolean. DATEX II native type: Boolean.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
