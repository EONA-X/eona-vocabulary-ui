		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-teslaConnectorEurope"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-pantographTopDown"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-pantographBottomUp"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec60309x2three64"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec60309x2three32"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec60309x2three16"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec60309x2single16"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-cee5"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-cee3"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-domestic"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-yazaki"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-chademo"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T3C"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T3A"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T1COMBO"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T1"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T2COMBO"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T2"/>
		<source xmlns="http://purl.org/dc/terms/">DATEX II Connector.connectorType (ConnectorTypeEnum, per IEC 62196 / IEC 60309); hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: enumeration (ConnectorTypeEnum) — see narrower code values. Required in DATEX II.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/Connector"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The type of physical connector / charging interface offered (e.g. Type 2, CCS Combo 2, CHAdeMO).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Connector type</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/Connector"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/Connector">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/maximumCurrent"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/voltage"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/maxPowerAtSocket"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorFormat"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/chargingMode"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType"/>
		<source xmlns="http://purl.org/dc/terms/">DATEX II EnergyInfrastructure: Connector; hub-curated SKOS rendering.</source>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">Parameters and description of an interface available at an electric charging point to connect vehicles (the charging interface type and cable information).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Connector</prefLabel>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/location">
		<source xmlns="http://purl.org/dc/terms/">DATEX II Facility.location (inherited by RefillPoint/ElectricChargingPoint); hub-curated SKOS rendering.</source>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Location); coordinates expressed as xsd:decimal degrees (latitude/longitude). Inherited from Facility.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The geographic location of the charging point, expressed as latitude and longitude coordinates.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Location (latitude/longitude)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/electricEnergyMix">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricChargingPoint.electricEnergyMix; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II ElectricEnergyMix) — see the Electric energy mix entity.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The mix of energy sources of the electricity delivered at the charging point.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Electric energy mix</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/connector">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricChargingPoint.connector; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/Connector"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II Connector) — see the Connector entity. Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A physical charging interface available at the charging point. A charging point may expose several connectors.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Connector (charging interface)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/availableVoltage">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricChargingPoint.availableVoltage; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:decimal (V). DATEX II native type: Volt (float), multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A possible degree of voltage offered by the charging point. May be multi-valued.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Available voltage (V)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/availableChargingPower">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricChargingPoint.availableChargingPower; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:decimal (kW). DATEX II native type: Watt (float), multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A possible degree of charging power offered by the charging point. May be multi-valued (a charging point can support several power levels).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Available charging power (kW)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/power">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricChargingPoint power (availableChargingPower / Connector.maxPowerAtSocket); hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:decimal (kW). DATEX II native type: Watt (float), e.g. ElectricChargingPoint.availableChargingPower / Connector.maxPowerAtSocket.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The rated electrical power of the charging point, expressed in kilowatts.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Rated power (kW)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/status-unknown">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">unknown</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The operational status of the charging point is unknown.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Unknown</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/status-outOfService">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">outOfService</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The charging point is not operational (technical defect or maintenance).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Out of service</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/status-reserved">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">reserved</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The charging point is reserved and not available for general use.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reserved</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/status-occupied">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">occupied</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The charging point is currently in use by a vehicle.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Occupied</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/status-available">
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">available</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The charging point is operational and free to use.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Available</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/status">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status-unknown"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status-outOfService"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status-reserved"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status-occupied"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status-available"/>
		<source xmlns="http://purl.org/dc/terms/">DATEX II Facility availability / status (Facilities model); hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: enumeration — see narrower code values. Rendered from the DATEX II Facilities availability / OperatingStatus model; the code set is hub-curated to an OCPI-style status list.</scopeNote>
