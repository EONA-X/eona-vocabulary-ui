	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/electricEnergySourceRatio">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricEnergyMix.electricEnergySourceRatio; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergySourceRatio"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: object reference (DATEX II ElectricEnergySourceRatio) — see the ElectricEnergySourceRatio entity. Multi-valued.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">A source/ratio pair making up this energy mix (e.g. 40% solar). The containment edge from ElectricEnergyMix down to ElectricEnergySourceRatio.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Electric energy source ratio (containment)</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/energyMixIndex">
		<source xmlns="http://purl.org/dc/terms/">DATEX II ElectricEnergyMix/@energyMixIndex; hub-curated SKOS rendering.</source>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#">Value type: xsd:integer. DATEX II native type: Integer (XML attribute). Required in DATEX II.</scopeNote>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#">The index (ordinal) of this energy mix entry among the charging point&apos;s possible energy mixes.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Energy mix index</prefLabel>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricEnergyMix"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/datex-ii/energy-infrastructure"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/datex-ii/energyMixRates">
