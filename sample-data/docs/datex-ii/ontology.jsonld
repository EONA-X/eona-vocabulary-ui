.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Refill point status (containment)"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStationStatus"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/datex-ii/energy-infrastructure"}], "@type": ["http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/datex-ii/isAvailable", "http://purl.org/dc/terms/source": [{"@value": "DATEX II EnergyInfrastructureStationStatus.isAvailable; hub-curated SKOS rendering."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "http://www.w3.org/2001/XMLSchema#boolean"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@value": "Value type: xsd:boolean. DATEX II native type: Boolean."}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStationStatus"}], "http://purl.org/dc/terms/type": [{"@value": "Attribute"}], "http://www.w3.org/2004/02/skos/core#definition": [{"@value": "Whether the station as a whole is currently available."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Is available"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStationStatus"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/datex-ii/energy-infrastructure"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStationStatus", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/datex-ii/refillPointStatus"}, {"@id": "https://vocab.eona-x.eu/datex-ii/isAvailable"}], "http://purl.org/dc/terms/source": [{"@value": "DATEX II EnergyInfrastructure: EnergyInfrastructureStationStatus (exte