[{"@id": "https://w3id.org/eonax/policy/leftOperands", "http://www.w3.org/2004/02/skos/core#member": [{"@id": "https://w3id.org/eonax/policy/RestrictedDiscoveryClaim"}, {"@id": "https://w3id.org/eonax/policy/GenericClaim"}, {"@id": "https://w3id.org/eonax/policy/Membership"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "The custom credential-claim left operands defined by this profile."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Eona-X constraint left operands"}], "@type": ["http://www.w3.org/2004/02/skos/core#Collection"]}, {"@id": "https://w3id.org/eonax/policy/supportedConstraintTerms", "http://www.w3.org/2004/02/skos/core#member": [{"@id": "http://www.w3.org/ns/odrl/2/rightOperand"}, {"@id": "http://www.w3.org/ns/odrl/2/operator"}, {"@id": "http://www.w3.org/ns/odrl/2/leftOperand"}, {"@id": "http://www.w3.org/ns/odrl/2/or"}, {"@id": "http://www.w3.org/ns/odrl/2/LogicalConstraint"}, {"@id": "http://www.w3.org/ns/odrl/2/Constraint"}, {"@id": "http://www.w3.org/ns/odrl/2/constraint"}, {"@id": "http://www.w3.org/ns/odrl/2/action"}, {"@id": "http://www.w3.org/ns/odrl/2/assignee"}, {"@id": "http://www.w3.org/ns/odrl/2/assigner"}, {"@id": "http://www.w3.org/ns/odrl/2/target"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "ODRL relation and constraint properties used when authoring policies in this profile. Note: odrl:assigner (and odrl:assignee where present) MUST be a Decentralized Identifier (did:...), validated by OdrlPolicyDidValidator."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Supported constraint & relation terms"}], "@type": ["http://www.w3.org/2004/02/skos/core#Collection"]}, {"@id": "https://w3id.org/eonax/policy/supportedOperators", "http://www.w3.org/2004/02/skos/core#member": [{"@id": "http://www.w3.org/ns/odrl/2/hasPart"}, {"@id": "http://www.w3.org/ns/odrl/2/isAnyOf"}, {"@id": "http://www.w3.org/ns/odrl/2/neq"}, {"@id": "http://www.w3.org/ns/odrl/2/eq"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Relational/set operators the constraint functions accept. odrl:eq and odrl:neq are scalar equality; odrl:isAnyOf is the EDC IN operator (scalar value is one of a right-operand set). odrl:hasPart is the TARGET set-containment operator (a set-valued claim contains the right-operand value) — see Eona-X/backlog#587."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Supported operators"}], "@type": ["http://www.w3.org/2004/02/skos/core#Collection"]}, {"@id": "https://w3id.org/eonax/policy/supportedActions", "http://www.w3.org/2004/02/skos/core#member": [{"@id": "http://www.w3.org/ns/odrl/2/distribute"}, {"@id": "http://www.w3.org/ns/odrl/2/share"}, {"@id": "http://www.w3.org/ns/odrl/2/transfer"}, {"@id": "http://www.w3.org/ns/odrl/2/use"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Actions bound into every rule scope by PolicyEvaluationExtension: the base odrl:use plus transfer, share and distribute. NOTE: odrl:share is deprecated in ODRL 2.2 but is still bound by the connector."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Supported actions"}], "@type": ["http://www.w3.org/2004/02/skos/core#Collection"]}, {"@id": "https://w3id.org/eonax/policy/supportedRules", "http://www.w3.org/2004/02/skos/core#member": [{"@id": "http://www.w3.org/ns/odrl/2/permission"}, {"@id": "http://www.w3.org/ns/odrl/2/Permission"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Only odrl:Permission is enforced: the credential constraint functions are registered for the Permission rule type. odrl:Prohibition / odrl:Duty may appear in a policy but carry no custom enforcement in this profile."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Supported rules"}], "@type": ["http://www.w3.org/2004/02/skos/core#Collection"]}, {"@id": "https://w3id.org/eonax/policy/supportedPolicyTypes", "http://www.w3.org/2004/02/skos/core#member": [{"@id": "http://www.w3.org/ns/odrl/2/Agreement"}, {"@id": "http://www.w3.org/ns/odrl/2/Offer"}, {"@id": "http://www.w3.org/ns/odrl/2/Set"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "ODRL policy subclasses the connector processes."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Supported policy types"}], "@type": ["http://www.w3.org/2004/02/skos/core#Collection"]}, {"@id": "https://w3id.org/eonax/policy/RestrictedDiscoveryClaim", "http://www.w3.org/2004/02/skos/core#example": [{"@language": "en", "@value": "eox-policy:RestrictedDiscoveryClaim.$.MembershipCredential.groups hasPart \"EMDS\""}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Supported operators today: odrl:eq, odrl:neq, set-membership (EDC IN / odrl:isAnyOf). TARGET (Eona-X/backlog#587): odrl:hasPart for set-valued claims."}], "http://www.w3.org/2004/02/skos/core#note": [{"@language": "en", "@value": "Addressing form: eox-policy:RestrictedDiscoveryClaim.$.<CredentialType>.<jsonPath>. Bound to the catalog.discovery, contract.negotiation and transfer rule scopes; it is the discovery-time counterpart of eox-policy:GenericClaim."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Constraint left operand equivalent to GenericClaim but evaluated in the catalog-discovery path, so that a dataset's visibility in the federated catalog is gated on a credential claim."}], "http://www.w3.org/2000/01/rdf-schema#label": [{"@language": "en", "@value": "Restricted Discovery Claim"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://w3id.org/eonax/policy/"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/ns/odrl/2/LeftOperand"]}, {"@id": "https://w3id.org/eonax/policy/GenericClaim", "http://www.w3.org/2004/02/skos/core#example": [{"@language": "en", "@value": "eox-policy:GenericClaim.$.MembershipCredential.groups hasPart \"EMDS\""}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Supported operators today: odrl:eq, odrl:neq, and set-membership (EDC operator IN, i.e. odrl:isAnyOf) where a scalar claim value must be one of a right-operand list. TARGET (Eona-X/backlog#587): odrl:hasPart, where a SET-valued claim (e.g. groups) must CONTAIN the right-operand value — the direction eq/neq/isAnyOf cannot express."}], "http://www.w3.org/2004/02/skos/core#note": [{"@language": "en", "@value": "Addressing form: eox-policy:GenericClaim.$.<CredentialType>.<jsonPath> — e.g. eox-policy:GenericClaim.$.MembershipCredential.groups. After the $ the first segment selects the credential type; the remaining dotted path selects a field in credentialSubject[0] claims. Bound to the contract.negotiation and transfer rule scopes."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Constraint left operand that addresses an arbitrary claim inside a presented credential's credentialSubject and compares it against the right operand."}], "http://www.w3.org/2000/01/rdf-schema#label": [{"@language": "en", "@value": "Generic Claim"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://w3id.org/eonax/policy/"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/ns/odrl/2/LeftOperand"]}, {"@id": "https://w3id.org/eonax/policy/Membership", "http://www.w3.org/2004/02/skos/core#example": [{"@language": "en", "@value": "eox-policy:Membership eq \"active\""}], "http://www.w3.org/2004/02/skos/core#note": [{"@language": "en", "@value": "Usage: leftOperand eox-policy:Membership, operator odrl:eq, rightOperand \"active\". Satisfied when the presented credentials contain at least one credential whose type is MembershipCredential (presence == active; the right operand MUST be the literal \"active\"). Bound to the transfer, catalog, contract.negotiation and catalog.discovery rule scopes."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Constraint left operand asserting that the presenting participant holds a valid MembershipCredential in the dataspace."}], "http://www.w3.org/2000/01/rdf-schema#label": [{"@language": "en", "@value": "Membership"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://w3id.org/eonax/policy/"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/ns/odrl/2/LeftOperand"]}, {"@id": "https://w3id.org/eonax/policy/", "http://purl.org/dc/terms/source": [{"@type": "http://www.w3.org/2001/XMLSchema#anyURI", "@value": "https://w3id.org/eonax/policy/"}], "http://www.w3.org/2000/01/rdf-schema#seeAlso": [{"@id": "http://www.w3.org/ns/odrl/2/"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@language": "en", "@value": "Descriptive, enforcement-scoped profile: it lists precisely the ODRL terms the connector binds and evaluates. Rules are enforced for odrl:Permission only (the constraint functions are registered for the Permission rule type). Evaluation always runs as a side effect of a Dataspace-Protocol interaction (catalog, contract negotiation, transfer) or catalog discovery — never as a standalone call."}], "http://purl.org/dc/terms/description": [{"@language": "en", "@value": "An ODRL 2.2 profile describing the exact subset of ODRL the Eona-X connector supports to express and enforce access & usage policies, extended with three credential-claim leftOperands evaluated by the connector's policy engine against presented Verifiable Credentials."}], "http://purl.org/dc/terms/conformsTo": [{"@id": "http://www.w3.org/ns/odrl/2/"}], "http://www.w3.org/2002/07/owl#versionInfo": [{"@value": "0.0.1"}], "http://purl.org/dc/terms/title": [{"@language": "en", "@value": "Eona-X ODRL Profile"}], "http://www.w3.org/2000/01/rdf-schema#label": [{"@language": "en", "@value": "Eona-X ODRL Profile"}], "@type": ["http://www.w3.org/2002/07/owl#Ontology"]}]