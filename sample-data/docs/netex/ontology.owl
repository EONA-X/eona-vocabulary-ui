		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Charging equipment is currently in use.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Occupied</prefLabel>
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">occupied</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/availabilityStatus-available">
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Charging equipment is available for use.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Available</prefLabel>
		<notation xmlns="http://www.w3.org/2004/02/skos/core#">available</notation>
		<type xmlns="http://purl.org/dc/terms/">Code value</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/batteryChemistryNameOfClassifiedEntityClass">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx attribute nameOfClassifiedEntityClass, type NameOfClass, on element TypeOfBatteryChemistry, xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:string (NeTEx NameOfClass — a common framework simple type external to this subset&apos;s 5 scoped XSDs)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Name of the class of ENTITY that the TYPE OF BATTERY CHEMISTRY classifies. Allows reflection; fixed for each ENTITY type.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Name of classified entity class (Type Of Battery Chemistry)</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/TypeOfBatteryChemistry"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/TypeOfBatteryChemistry"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/plugNameOfClassifiedEntityClass">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx attribute nameOfClassifiedEntityClass, type NameOfClass, on element TypeOfPlug, xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:string (NeTEx NameOfClass — a common framework simple type external to this subset&apos;s 5 scoped XSDs)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Name of the class of ENTITY that the TYPE OF PLUG classifies. Allows reflection; fixed for each ENTITY type.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Name of classified entity class (Type Of Plug)</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/TypeOfPlug"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/TypeOfPlug"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/vehicleChargingEquipment">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element VehicleChargingEquipmentRef (ref, minOccurs=0), RechargingPointAssignmentGroup, xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd.</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: reference to netex:ElectricVehicleChargingEquipment</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The VEHICLE CHARGING EQUIPMENT located at the site component/equipment place to which the recharging point is assigned.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Vehicle charging equipment</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/equipmentPlace">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element EquipmentPlaceRef (ref, minOccurs=0), RechargingPointAssignmentGroup, xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd.</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: reference (NeTEx EquipmentPlaceRef); EQUIPMENT PLACE is out of scope for this EV-charging subset</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The EQUIPMENT PLACE to which the recharging point is assigned.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Equipment place</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/siteComponent">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element SiteComponentRef (ref, minOccurs=0), RechargingPointAssignmentGroup, xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd.</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: reference (NeTEx SiteComponentRef); SITE COMPONENT is out of scope for this EV-charging subset</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The SITE COMPONENT (such as a PARKING BAY) to which the recharging point is assigned.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Site component</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/compatibleWith">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element compatibleWith, type compatibleEquipmentRefs_RelStructure (+v2.0), RechargingEquipmentProfileGroup, xsd/netex_framework/netex_reusableComponents/netex_nm_chargingEquipmentProfile_version.xsd; the RelStructure wrapper is a list container, not modelled as its own Entity (see TERMS.md judgement calls).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: reference list, a choice of VehicleChargingEquipmentRef | RefuellingEquipmentRef | BatteryEquipmentRef (NeTEx compatibleEquipmentRefs_RelStructure)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The VEHICLE CHARGING EQUIPMENT, REFUELLING EQUIPMENT and/or BATTERY EQUIPMENT that this recharging equipment profile is compatible with.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Compatible with</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/profileTypeOfPlug">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element TypeOfPlugRef (ref, minOccurs=0), RechargingEquipmentProfileGroup, xsd/netex_framework/netex_reusableComponents/netex_nm_chargingEquipmentProfile_version.xsd.</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/TypeOfPlug"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: reference to netex:TypeOfPlug</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An extensible classification reference for the plug required/supported by the recharging equipment profile, in addition to the closed PlugType enumeration (netex:profilePlugType).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Profile type of plug</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/typeOfPlug">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element TypeOfPlugRef (ref, minOccurs=0), VehicleChargingEquipmentGroup, xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/TypeOfPlug"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: reference to netex:TypeOfPlug</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An extensible classification reference for the plug supported by the charging equipment, in addition to the closed PlugType enumeration (netex:connectorStandard).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Type of plug</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/profilePowerCouplingType">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx enumeration: PowerCouplingTypeEnumeration (code values listed under netex:powerCouplingType).</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/powerCouplingType"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: enumeration (NeTEx PowerCouplingTypeEnumeration; values listed under powerCouplingType)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The power coupling type required/supported by the recharging equipment profile. Shares the NeTEx PowerCouplingTypeEnumeration value set with the equipment&apos;s power coupling type.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Profile power coupling type</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/profileCurrentType">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx enumeration: CurrentTypeEnumeration (code values listed under netex:currentType).</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/currentType"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: enumeration (NeTEx CurrentTypeEnumeration; values listed under currentType)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The current type required/supported by the recharging equipment profile. Shares the NeTEx CurrentTypeEnumeration value set with the equipment&apos;s current type.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Profile current type</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/profilePlugType">
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx enumeration: PlugTypeEnumeration (code values listed under netex:connectorStandard).</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: enumeration (NeTEx PlugTypeEnumeration; values listed under connectorStandard)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The plug type required/supported by the recharging equipment profile. Shares the NeTEx PlugTypeEnumeration value set with the equipment&apos;s connector standard.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Profile plug type</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/finalisationDuration">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element FinalisationDuration (xsd:duration).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:duration</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Normal time to decouple after charging. Renders the NeTEx FinalisationDuration.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Finalisation duration</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/preparationDuration">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element PreparationDuration (xsd:duration).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:duration</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Typical time period needed to set up the charging process. Renders the NeTEx PreparationDuration.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Preparation duration</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
