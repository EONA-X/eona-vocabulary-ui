		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/gridVoltage">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element GridVoltage, type VoltageType (xsd:decimal, SI volts).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:decimal (V)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The grid supply voltage delivered to the charging equipment.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Grid voltage (V)</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/reservationUrl">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element ReservationUrl (xsd:anyURI).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:anyURI</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A URL at which the charging equipment can be reserved.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reservation URL</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/reservationRequired">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element ReservationRequired (xsd:boolean).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:boolean</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Whether a reservation is required to use the charging equipment.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reservation required</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/freeRecharging">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element FreeRecharging (xsd:boolean).</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:boolean</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Whether the charging equipment can be used without a fee.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Free recharging</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/location">
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: structured (Transmodel POINT / LOCATION; WGS84 latitude/longitude)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The geographic location of the charging equipment, expressed via a Transmodel POINT / LOCATION (WGS84 latitude/longitude). In NeTEx the equipment is placed through an EQUIPMENT PLACE / SITE COMPONENT.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Location (Transmodel Point/Location)</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/connectorStandard">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-shockproof"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-CHAdeMO"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-avcon"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-nema520"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-tesla"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo2Plug"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo1Plug"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-combinedChargingSystem"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-typeJ"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-typeG"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-typeF"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-typeE"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-type3"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-type2"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-type1"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard-undefined"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx enumeration: PlugTypeEnumeration.</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: enumeration (NeTEx PlugTypeEnumeration). Each value may also be classified by a NeTEx TypeOfPlug.</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The physical connector / plug standard offered by the charging equipment (e.g. Type 2, CCS, CHAdeMO). Renders the NeTEx PlugType.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Connector standard (plug type)</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/powerRating">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx element MaximumPower, type WattageType (xsd:decimal, SI watts). Exposed here in kW for alignment with datex:power.</editorialNote>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: xsd:decimal (kW; NeTEx native WattageType MaximumPower is expressed in watts [W])</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The rated electrical power of the charging equipment. Renders the NeTEx MaximumPower of VEHICLE CHARGING EQUIPMENT.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Power rating (kW)</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/availabilityStatus">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus-unknown"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus-outOfService"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus-reserved"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus-occupied"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus-available"/>
		<editorialNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NeTEx enumeration: AvailabilityStatusEnumeration (hub-curated; NeTEx static schema carries no equipment-level availability — real-time status is conveyed via SIRI).</editorialNote>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus"/>
		<scopeNote xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Value type: enumeration (hub-curated availability status; NeTEx native real-time availability is a SIRI concern)</scopeNote>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Operational availability status of the charging equipment (e.g. available, occupied, out of service).</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Availability status</prefLabel>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<type xmlns="http://purl.org/dc/terms/">Attribute</type>
		<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/RechargingBay">
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element RechargingBay (substitutionGroup ParkingBay_Dummy, complexType RechargingBay_VersionStructure, +v2.0), xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A PARKING BAY specifically equipped for recharging VEHICLEs; the individual bay within a RECHARGING STATION.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Recharging Bay</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/TypeOfBatteryChemistry">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/batteryChemistryNameOfClassifiedEntityClass"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element TypeOfBatteryChemistry (substitutionGroup TypeOfEntity, complexType TypeOfBatteryChemistry_ValueStructure, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A classification of a BATTERY CHEMISTRY (e.g. lithium-ion, lead-acid). Gives the chemistry referenced by a BATTERY EQUIPMENT&apos;s typeOfBatteryChemistry an extensible, referenceable TYPE OF ENTITY classification.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Type Of Battery Chemistry</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/TypeOfPlug">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/plugNameOfClassifiedEntityClass"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element TypeOfPlug (substitutionGroup TypeOfEntity, complexType TypeOfPlug_ValueStructure, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A classification of a PLUG. Gives the plug supported by a VEHICLE CHARGING EQUIPMENT or required by a RECHARGING EQUIPMENT PROFILE an extensible, referenceable TYPE OF ENTITY classification, in addition to the closed PlugTypeEnumeration code list.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Type Of Plug</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/profilePowerCouplingType"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/profileCurrentType"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/profilePlugType"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/finalisationDuration"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/preparationDuration"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/profileMaximumChargingPower"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/chargingVoltage"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element RechargingEquipmentProfile (specialisation of VehicleEquipmentProfile), xsd/netex_framework/netex_reusableComponents/netex_nm_chargingEquipmentProfile_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A VEHICLE EQUIPMENT PROFILE describing the charging features a vehicle requires or supports (plug, current, coupling, charging voltage, maximum charging power and timing). Used to match vehicles to compatible charging equipment.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Recharging Equipment Profile</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/RechargingPointAssignment">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/servedScheduledStopPoints"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element RechargingPointAssignment (+v2.0), xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The allocation of a public-transport timing point to a site component (such as a PARKING BAY) that holds VEHICLE CHARGING EQUIPMENT; the link that integrates charging infrastructure into the NeTEx public-transport network.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Recharging Point Assignment</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/RechargingStation">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/totalPower"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element RechargingStation (specialisation of Parking, +v2.0), xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd; contains RechargingBay (a PARKING BAY equipped for recharging).</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A PARKING whose bays (RECHARGING BAYs) are specifically equipped for recharging vehicles. Aggregates the total power available to all of its recharging bays.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Recharging Station</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/BatteryEquipment">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/typeOfBatteryChemistry"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/maximumChargingPower"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/nominalVoltage"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/batteryUsableCapacity"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/batteryCapacity"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element BatteryEquipment (specialisation of InstalledEquipment, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Installed battery equipment characterising the energy store that is charged (a specialisation of INSTALLED EQUIPMENT). Describes capacity, voltage and maximum charging power.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Battery Equipment</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/RefuellingEquipment">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/fuelType"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element RefuellingEquipment (specialisation of PlaceEquipment, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Equipment for refuelling a vehicle with an alternative or conventional fuel (a specialisation of PLACE EQUIPMENT). Covers non-electric and electric energy supply via its fuel-type classification.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refuelling Equipment</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment">
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/powerCouplingType"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/currentType"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/gridVoltage"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/reservationUrl"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/reservationRequired"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/freeRecharging"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/location"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/powerRating"/>
		<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus"/>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 element VehicleChargingEquipment (specialisation of PlaceEquipment), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd.</source>
		<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Equipment at which an electric vehicle can be connected to charge its battery. Renders the NeTEx VEHICLE CHARGING EQUIPMENT (a specialisation of PLACE EQUIPMENT) in a Transmodel/NeTEx style.</definition>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Electric Vehicle Charging Equipment</prefLabel>
		<type xmlns="http://purl.org/dc/terms/">Entity</type>
		<topConceptOf xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ev-charging"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex/ev-charging">
		<hasTopConcept xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingEquipmentProfile"/>
		<hasTopConcept xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingPointAssignment"/>
		<hasTopConcept xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RechargingStation"/>
		<hasTopConcept xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/BatteryEquipment"/>
		<hasTopConcept xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/RefuellingEquipment"/>
		<hasTopConcept xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<source xmlns="http://purl.org/dc/terms/">Hub-curated SKOS rendering of the NeTEx v2.0 (CEN/TS 16614, Transmodel-based) charging/alternative-fuel subset; NeTEx is natively XSD and PT-scoped.</source>
		<description xmlns="http://purl.org/dc/terms/">Vehicle-charging and alternative-fuel terms rendered in a Transmodel/NeTEx style (entities, attributes and code values) as an adjacent subset for the EMDS demo.</description>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#">NeTEx/Transmodel — EV charging &amp; alternative-fuel (subset)</label>
		<title xmlns="http://purl.org/dc/terms/">NeTEx/Transmodel — EV charging &amp; alternative-fuel (subset)</title>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/netex">
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#">NeTEx/Transmodel — EV charging &amp; alternative-fuel subset</label>
		<versionInfo xmlns="http://www.w3.org/2002/07/owl#">0.2.0</versionInfo>
		<modified xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-26</modified>
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</created>
		<creator xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub</creator>
		<source xmlns="http://purl.org/dc/terms/">NeTEx v2.0 XSDs (github.com/TransmodelEcosystem/NeTEx, branch v2.0): netex_nm_equipmentEnergy_version.xsd, netex_nm_chargingEquipmentProfile_version.xsd, netex_rechargingPointAssignment_version.xsd, netex_units.xsd. NeTEx site https://netex-cen.eu/ ; Transmodel http://www.transmodel-cen.eu/ . NeTEx is natively XSD and PT-scoped; this is a curated SKOS rendering of an adjacent EV-charging/alternative-fuel subset.</source>
		<description xmlns="http://purl.org/dc/terms/">Hub-curated SKOS rendering of the NeTEx (CEN/TS 16614, Transmodel-based) vehicle-charging and alternative-fuel subset: VEHICLE CHARGING EQUIPMENT, REFUELLING EQUIPMENT, BATTERY EQUIPMENT, RECHARGING STATION and RECHARGING POINT ASSIGNMENT plus the RECHARGING EQUIPMENT PROFILE, with their attributes and PlugType/CurrentType/PowerCouplingType/FuelType enumerations. NeTEx proper is natively XSD and PT-scoped; this is an adjacent, browsable subset for the EMDS demo.</description>
		<title xmlns="http://purl.org/dc/terms/">NeTEx/Transmodel — EV charging &amp; alternative-fuel subset (EONA-X hub-curated)</title>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	</rdf:Description>
</rdf:RDF>