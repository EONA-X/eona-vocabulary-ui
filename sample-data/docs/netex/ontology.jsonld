re#scopeNote": [{"@language": "en", "@value": "Value type: xsd:boolean"}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Whether the charging equipment can be used without a fee."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Free recharging"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://purl.org/dc/terms/type": [{"@value": "Attribute"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/location", "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Value type: structured (Transmodel POINT / LOCATION; WGS84 latitude/longitude)"}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "The geographic location of the charging equipment, expressed via a Transmodel POINT / LOCATION (WGS84 latitude/longitude). In NeTEx the equipment is placed through an EQUIPMENT PLACE / SITE COMPONENT."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Location (Transmodel Point/Location)"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://purl.org/dc/terms/type": [{"@value": "Attribute"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-shockproof"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-CHAdeMO"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-avcon"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-nema520"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-tesla"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo2Plug"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo1Plug"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-combinedChargingSystem"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-typeJ"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-typeG"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-typeF"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-typeE"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type3"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type2"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type1"}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-undefined"}], "http://www.w3.org/2004/02/skos/core#editorialNote": [{"@language": "en", "@value": "NeTEx enumeration: PlugTypeEnumeration."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Value type: enumeration (NeTEx PlugTypeEnumeration). Each value may also be classified by a NeTEx TypeOfPlug."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "The physical connector / plug standard offered by the charging equipment (e.g. Type 2, CCS, CHAdeMO). Renders the NeTEx PlugType."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Connector standard (plug type)"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://purl.org/dc/terms/type": [{"@value": "Attribute"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/powerRating", "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "http://www.w3.org/2001/XMLSchema#decimal"}], "http://www.w3.org/2004/02/skos/core#editorialNote": [{"@language": "en", "@value": "NeTEx element MaximumPower, type WattageType (xsd:decimal, SI watts). Exposed here in kW for alignment with datex:power."}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Value type: xsd:decimal (kW; NeTEx native WattageType MaximumPower is expressed in watts [W])"}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "The rated electrical power of the charging equipment. Renders the NeTEx MaximumPower of VEHICLE CHARGING EQUIPMENT."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Power rating (kW)"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://purl.org/dc/terms/type": [{"@value": "Attribute"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/availabilityStatus", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/availabilityStatus-unknown"}, {"@id": "https://vocab.eona-x.eu/netex/availabilityStatus-outOfService"}, {"@id": "https://vocab.eona-x.eu/netex/availabilityStatus-reserved"}, {"@id": "https://vocab.eona-x.eu/netex/availabilityStatus-occupied"}, {"@id": "https://vocab.eona-x.eu/netex/availabilityStatus-available"}], "http://www.w3.org/2004/02/skos/core#editorialNote": [{"@language": "en", "@value": "NeTEx enumeration: AvailabilityStatusEnumeration (hub-curated; NeTEx static schema carries no equipment-level availability — real-time status is conveyed via SIRI)."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://vocab.eona-x.eu/netex/availabilityStatus"}], "http://www.w3.org/2004/02/skos/core#scopeNote": [{"@language": "en", "@value": "Value type: enumeration (hub-curated availability status; NeTEx native real-time availability is a SIRI concern)"}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Operational availability status of the charging equipment (e.g. available, occupied, out of service)."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Availability status"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://purl.org/dc/terms/type": [{"@value": "Attribute"}], "http://www.w3.org/2004/02/skos/core#broader": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/RechargingBay", "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 element RechargingBay (substitutionGroup ParkingBay_Dummy, complexType RechargingBay_VersionStructure, +v2.0), xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "A PARKING BAY specifically equipped for recharging VEHICLEs; the individual bay within a RECHARGING STATION."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Recharging Bay"}], "http://purl.org/dc/terms/type": [{"@value": "Entity"}], "http://www.w3.org/2004/02/skos/core#topConceptOf": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/TypeOfBatteryChemistry", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/batteryChemistryNameOfClassifiedEntityClass"}], "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 element TypeOfBatteryChemistry (substitutionGroup TypeOfEntity, complexType TypeOfBatteryChemistry_ValueStructure, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "A classification of a BATTERY CHEMISTRY (e.g. lithium-ion, lead-acid). Gives the chemistry referenced by a BATTERY EQUIPMENT's typeOfBatteryChemistry an extensible, referenceable TYPE OF ENTITY classification."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Type Of Battery Chemistry"}], "http://purl.org/dc/terms/type": [{"@value": "Entity"}], "http://www.w3.org/2004/02/skos/core#topConceptOf": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/TypeOfPlug", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/plugNameOfClassifiedEntityClass"}], "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 element TypeOfPlug (substitutionGroup TypeOfEntity, complexType TypeOfPlug_ValueStructure, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "A classification of a PLUG. Gives the plug supported by a VEHICLE CHARGING EQUIPMENT or required by a RECHARGING EQUIPMENT PROFILE an extensible, referenceable TYPE OF ENTITY classification, in addition to the closed PlugTypeEnumeration code list."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Type Of Plug"}], "http://purl.org/dc/terms/type": [{"@value": "Entity"}], "http://www.w3.org/2004/02/skos/core#topConceptOf": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/RechargingStation", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/totalPower"}], "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 element RechargingStation (specialisation of Parking, +v2.0), xsd/netex_part_1/part1_ifopt/netex_rechargingPointAssignment_version.xsd; contains RechargingBay (a PARKING BAY equipped for recharging)."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "A PARKING whose bays (RECHARGING BAYs) are specifically equipped for recharging vehicles. Aggregates the total power available to all of its recharging bays."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Recharging Station"}], "http://purl.org/dc/terms/type": [{"@value": "Entity"}], "http://www.w3.org/2004/02/skos/core#topConceptOf": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/BatteryEquipment", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/typeOfBatteryChemistry"}, {"@id": "https://vocab.eona-x.eu/netex/maximumChargingPower"}, {"@id": "https://vocab.eona-x.eu/netex/nominalVoltage"}, {"@id": "https://vocab.eona-x.eu/netex/batteryUsableCapacity"}, {"@id": "https://vocab.eona-x.eu/netex/batteryCapacity"}], "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 element BatteryEquipment (specialisation of InstalledEquipment, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Installed battery equipment characterising the energy store that is charged (a specialisation of INSTALLED EQUIPMENT). Describes capacity, voltage and maximum charging power."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Battery Equipment"}], "http://purl.org/dc/terms/type": [{"@value": "Entity"}], "http://www.w3.org/2004/02/skos/core#topConceptOf": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex/RefuellingEquipment", "http://www.w3.org/2004/02/skos/core#narrower": [{"@id": "https://vocab.eona-x.eu/netex/fuelType"}], "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 element RefuellingEquipment (specialisation of PlaceEquipment, +v1.2.2), xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd."}], "http://www.w3.org/2004/02/skos/core#definition": [{"@language": "en", "@value": "Equipment for refuelling a vehicle with an alternative or conventional fuel (a specialisation of PLACE EQUIPMENT). Covers non-electric and electric energy supply via its fuel-type classification."}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Refuelling Equipment"}], "http://purl.org/dc/terms/type": [{"@value": "Entity"}], "http://www.w3.org/2004/02/skos/core#topConceptOf": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}], "@type": ["http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2004/02/skos/core#Concept"]}, {"@id": "https://vocab.eona-x.eu/netex", "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "NeTEx/Transmodel — EV charging & alternative-fuel subset"}], "http://www.w3.org/2002/07/owl#versionInfo": [{"@value": "0.2.0"}], "http://purl.org/dc/terms/modified": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-26"}], "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/creator": [{"@value": "EONA-X Vocabulary Hub"}], "http://purl.org/dc/terms/source": [{"@value": "NeTEx v2.0 XSDs (github.com/TransmodelEcosystem/NeTEx, branch v2.0): netex_nm_equipmentEnergy_version.xsd, netex_nm_chargingEquipmentProfile_version.xsd, netex_rechargingPointAssignment_version.xsd, netex_units.xsd. NeTEx site https://netex-cen.eu/ ; Transmodel http://www.transmodel-cen.eu/ . NeTEx is natively XSD and PT-scoped; this is a curated SKOS rendering of an adjacent EV-charging/alternative-fuel subset."}], "http://purl.org/dc/terms/description": [{"@value": "Hub-curated SKOS rendering of the NeTEx (CEN/TS 16614, Transmodel-based) vehicle-charging and alternative-fuel subset: VEHICLE CHARGING EQUIPMENT, REFUELLING EQUIPMENT, BATTERY EQUIPMENT, RECHARGING STATION and RECHARGING POINT ASSIGNMENT plus the RECHARGING EQUIPMENT PROFILE, with their attributes and PlugType/CurrentType/PowerCouplingType/FuelType enumerations. NeTEx proper is natively XSD and PT-scoped; this is an adjacent, browsable subset for the EMDS demo."}], "http://purl.org/dc/terms/title": [{"@value": "NeTEx/Transmodel — EV charging & alternative-fuel subset (EONA-X hub-curated)"}], "@type": ["http://www.w3.org/2002/07/owl#Ontology"]}]