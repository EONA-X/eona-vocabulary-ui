[{"@id": "https://www.w3.org/ns/did#serviceEndpoint", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#services"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://www.w3.org/ns/did#Service"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://www.w3.org/ns/did#service", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#services"}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#Service"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://www.w3.org/ns/did#DIDSubject"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#publicKeyMultibase", "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "A string that conforms to a multibase encoded public key"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#verification-methods"}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "http://www.w3.org/2001/XMLSchema#string"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#publicKeyJwk", "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "Public Key in JWK"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#verification-methods"}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"}], "http://www.w3.org/2000/01/rdf-schema#domain": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#capabilityInvocationMethod", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#capability-invocation"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "The capabilityInvocation property is used to express a verification relationship which an entity can use to invoke capabilities as the DID subject or on behalf of the DID subject."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#capabilityDelegationMethod", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#capability-delegation"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "The capabilityDelegation property is used to express a verification relationship which an entity can use to grant capabilities as the DID subject or on behalf of the DID subject to other capability invokers. "}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#keyAgreementMethod", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#key-agreement"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "The keyAgreement property is used to express a verification relationship which an entity can use to engage in key agreement protocols on behalf of the DID subject."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#assertionMethod", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#assertion"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "The assertionMethod property is used to express a verification relationship which indicates that a verification method can be used to verify a proof that a statement was asserted on behalf of the DID subject."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#authenticationMethod", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#authentication"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "Authentication is a verification relationship which an entity can use to prove it is the DID subject or acting on behalf of the DID Subject as a DID Controller."}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#verificationMethod", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#verification-methods"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "A generic method to refer to a Verification Method"}], "http://www.w3.org/2000/01/rdf-schema#range": [{"@id": "https://www.w3.org/ns/did#VerificationMethod"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://w3id.org/security#controller", "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "An entity that is authorized to make changes to a DID Document"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#control"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://www.w3.org/ns/activitystreams#alsoKnownAs", "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "This relationship is a statement that the subject of this identifier is also identified by one or more other identifiers."}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#also-known-as"}], "@type": ["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"]}, {"@id": "https://www.w3.org/ns/did#Service", "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "Service Endpoint"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#services"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "Service endpoints are used in DID documents to express ways of communicating with the DID subject or associated entities"}], "@type": ["http://www.w3.org/2000/01/rdf-schema#Class"]}, {"@id": "https://www.w3.org/ns/did#VerificationMethod", "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "Verification Method"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#verification-methods"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "Superclass for all specific verification Methods. It is an 'abstract' class, never used by itself."}], "@type": ["http://www.w3.org/2000/01/rdf-schema#Class"]}, {"@id": "https://www.w3.org/ns/did#DIDSubject", "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "DID Document"}], "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [{"@id": "https://www.w3.org/TR/did-core/#core-properties"}], "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "Top level class for resources identified via a DID subject"}], "@type": ["http://www.w3.org/2000/01/rdf-schema#Class"]}, {"@id": "https://www.w3.org/ns/did#", "http://www.w3.org/2000/01/rdf-schema#comment": [{"@value": "For historical reasons, most of the terms are in the 'sec:' namespace rather than the 'did:' namespace. These terms do not describe/define any cryptographic primitives and are formally defined in the DID Core specification. Future Working Group may define a formal specification for the complete 'sec:' vocabulary."}], "@type": ["http://www.w3.org/2002/07/owl#Ontology"]}]