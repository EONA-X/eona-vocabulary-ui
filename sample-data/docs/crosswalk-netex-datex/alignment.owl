<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-charging-mode">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-26</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">relatedMatch (associative, not equivalence): DATEX II chargingMode (IEC 61851 modes 1-4, encoding AC/DC plus control) and NeTEx currentType (AC/DC) both characterise how charging is delivered, but at different granularity, so related rather than close or exact.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/currentType"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/chargingMode"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Charging mode ↔ current type</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-voltage">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-26</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">closeMatch: DATEX II &apos;voltage&apos; and NeTEx &apos;nominal voltage&apos; both denote the operating voltage of the charging equipment in volts (V); near-equivalent, framing differs slightly.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/nominalVoltage"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/voltage"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Voltage ↔ nominal voltage</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-max-power">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-26</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">closeMatch: both denote the maximum power the equipment can deliver, but DATEX II expresses it in kilowatts (kW) and NeTEx in watts (W); same quantity, different unit framing, so close rather than exact.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/maximumChargingPower"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/maxPowerAtSocket"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Maximum power at socket ↔ maximum charging power</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-station">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-26</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">closeMatch: DATEX II EnergyInfrastructureStation and NeTEx RechargingStation both denote the place that groups the charging points/equipment of a site; near-equivalent groupings, not asserted strictly identical.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/RechargingStation"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Station ↔ recharging station</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-location">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">exactMatch: both denote the geographic location of the charging facility (latitude/longitude resp. Transmodel Point/Location); the same real-world concept, interchangeable.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/location"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#exactMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/location"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Location ↔ location</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-connector">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">closeMatch: DATEX II frames the connector as a &apos;type&apos; and NeTEx as a &apos;standard&apos;; the underlying enumerations (Type 2, CCS, CHAdeMO, ...) overlap heavily but the framings/value sets are not asserted identical, so close rather than exact. The individual code values are aligned one-by-one in the connector code-value block (exact/closeMatch); Tesla and generic domestic plugs have no 1:1 NeTEx counterpart and are left unmapped.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/connectorStandard"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/connectorType"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Connector type ↔ connector standard</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-power">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">exactMatch: both denote the rated electrical power of the charging facility in kilowatts (kW); same quantity and units, interchangeable.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/powerRating"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#exactMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/power"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Rated power ↔ power rating</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-status">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">closeMatch: both denote the operational availability status of the charging facility; DATEX II&apos;s status enumeration and NeTEx&apos;s availabilityStatus are not guaranteed value-for-value identical, so close rather than exact.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/availabilityStatus"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/status"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Status ↔ availability status</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://vocab.eona-x.eu/alignments/map-charging-point">
		<created xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</created>
		<source xmlns="http://purl.org/dc/terms/">EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)</source>
		<note xmlns="http://www.w3.org/2004/02/skos/core#">closeMatch, not exactMatch: DATEX II models the single charging *point* whereas NeTEx models the charging *equipment* (the physical unit, which may expose several points); the concepts overlap closely but are not strictly equivalent.</note>
		<rdf:object rdf:resource="https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"/>
		<rdf:predicate rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
		<rdf:subject rdf:resource="https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"/>
		<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Charging point ↔ charging equipment</prefLabel>
		<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://vocab.eona-x.eu/alignments/netex-datex-ii"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
	</rdf:Description>
