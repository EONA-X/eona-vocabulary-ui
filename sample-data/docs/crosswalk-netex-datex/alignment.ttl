	<http://rdfs.org/ns/void#linkPredicate> <http://www.w3.org/2004/02/skos/core#relatedMatch> , <http://www.w3.org/2004/02/skos/core#closeMatch> , <http://www.w3.org/2004/02/skos/core#exactMatch> ;
	<http://purl.org/dc/terms/source> "Hub-curated EV-charging crosswalk for the EMDS demo (demo point C); not derived from an upstream NeTEx/DATEX II distribution — DATEX II and NeTEx are published natively as XSD and carry no canonical cross-standard SKOS mapping." ;
	<http://purl.org/dc/terms/creator> "EONA-X Vocabulary Hub" ;
	<http://purl.org/dc/terms/modified> "2026-06-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
	<http://purl.org/dc/terms/created> "2026-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
	<http://purl.org/dc/terms/description> "Hub-curated EV-charging (IRVE) crosswalk for the EMDS demo: SKOS alignment between the DATEX II EnergyInfrastructure subset (#433) and the NeTEx/Transmodel-style subset (#445), so a term in one vocabulary resolves to its counterpart in the other." ;
	<http://www.w3.org/2000/01/rdf-schema#label> "NeTEx ↔ DATEX II crosswalk (EV-charging)" ;
	<http://purl.org/dc/terms/title> "NeTEx ↔ DATEX II crosswalk (EV-charging)" ;
	<http://purl.org/dc/terms/identifier> "netex-datex-ii" ;
	a <http://www.w3.org/ns/dcat#Resource> , <http://rdfs.org/ns/void#Linkset> , <http://www.w3.org/2004/02/skos/core#ConceptScheme> .
