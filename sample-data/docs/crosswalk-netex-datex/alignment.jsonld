[{"@id": "https://vocab.eona-x.eu/alignments/map-charging-mode", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-26"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "relatedMatch (associative, not equivalence): DATEX II chargingMode (IEC 61851 modes 1-4, encoding AC/DC plus control) and NeTEx currentType (AC/DC) both characterise how charging is delivered, but at different granularity, so related rather than close or exact."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/currentType"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#relatedMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/chargingMode"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Charging mode ↔ current type"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-voltage", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-26"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "closeMatch: DATEX II 'voltage' and NeTEx 'nominal voltage' both denote the operating voltage of the charging equipment in volts (V); near-equivalent, framing differs slightly."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/nominalVoltage"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/voltage"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Voltage ↔ nominal voltage"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-max-power", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-26"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "closeMatch: both denote the maximum power the equipment can deliver, but DATEX II expresses it in kilowatts (kW) and NeTEx in watts (W); same quantity, different unit framing, so close rather than exact."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/maximumChargingPower"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/maxPowerAtSocket"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Maximum power at socket ↔ maximum charging power"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-station", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-26"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "closeMatch: DATEX II EnergyInfrastructureStation and NeTEx RechargingStation both denote the place that groups the charging points/equipment of a site; near-equivalent groupings, not asserted strictly identical."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/RechargingStation"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Station ↔ recharging station"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-location", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "exactMatch: both denote the geographic location of the charging facility (latitude/longitude resp. Transmodel Point/Location); the same real-world concept, interchangeable."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/location"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#exactMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/location"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Location ↔ location"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-connector", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "closeMatch: DATEX II frames the connector as a 'type' and NeTEx as a 'standard'; the underlying enumerations (Type 2, CCS, CHAdeMO, ...) overlap heavily but the framings/value sets are not asserted identical, so close rather than exact. The individual code values are aligned one-by-one in the connector code-value block (exact/closeMatch); Tesla and generic domestic plugs have no 1:1 NeTEx counterpart and are left unmapped."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Connector type ↔ connector standard"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-power", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "exactMatch: both denote the rated electrical power of the charging facility in kilowatts (kW); same quantity and units, interchangeable."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/powerRating"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#exactMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/power"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Rated power ↔ power rating"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-status", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "closeMatch: both denote the operational availability status of the charging facility; DATEX II's status enumeration and NeTEx's availabilityStatus are not guaranteed value-for-value identical, so close rather than exact."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/availabilityStatus"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/status"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Status ↔ availability status"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/alignments/map-charging-point", "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/source": [{"@value": "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)"}], "http://www.w3.org/2004/02/skos/core#note": [{"@value": "closeMatch, not exactMatch: DATEX II models the single charging *point* whereas NeTEx models the charging *equipment* (the physical unit, which may expose several points); the concepts overlap closely but are not strictly equivalent."}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#object": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate": [{"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}], "http://www.w3.org/1999/02/22-rdf-syntax-ns#subject": [{"@id": "https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"}], "http://www.w3.org/2004/02/skos/core#prefLabel": [{"@language": "en", "@value": "Charging point ↔ charging equipment"}], "http://www.w3.org/2004/02/skos/core#inScheme": [{"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii"}], "@type": ["http://www.w3.org/2004/02/skos/core#Concept", "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type1", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-yazaki"}], "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T1"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-yazaki", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type1"}]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type3", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T3A"}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T3C"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T3A", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type3"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T3C", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type3"}]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-CHAdeMO", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-chademo"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-chademo", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-CHAdeMO"}]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo2Plug", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T2COMBO"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T2COMBO", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo2Plug"}]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo1Plug", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T1COMBO"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T1COMBO", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-ccsCombo1Plug"}]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type2", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T2"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T2", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type2"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType-iec62196T1", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard-type1"}]}, {"@id": "https://vocab.eona-x.eu/netex/currentType", "http://www.w3.org/2004/02/skos/core#relatedMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/chargingMode"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/chargingMode", "http://www.w3.org/2004/02/skos/core#relatedMatch": [{"@id": "https://vocab.eona-x.eu/netex/currentType"}]}, {"@id": "https://vocab.eona-x.eu/netex/nominalVoltage", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/voltage"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/voltage", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/nominalVoltage"}]}, {"@id": "https://vocab.eona-x.eu/netex/maximumChargingPower", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/maxPowerAtSocket"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/maxPowerAtSocket", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/maximumChargingPower"}]}, {"@id": "https://vocab.eona-x.eu/netex/RechargingStation", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/EnergyInfrastructureStation", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/RechargingStation"}]}, {"@id": "https://vocab.eona-x.eu/netex/location", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/location"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/location", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/location"}]}, {"@id": "https://vocab.eona-x.eu/netex/connectorStandard", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/connectorType"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/connectorType", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/connectorStandard"}]}, {"@id": "https://vocab.eona-x.eu/netex/powerRating", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/power"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/power", "http://www.w3.org/2004/02/skos/core#exactMatch": [{"@id": "https://vocab.eona-x.eu/netex/powerRating"}]}, {"@id": "https://vocab.eona-x.eu/netex/availabilityStatus", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/status"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/status", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/availabilityStatus"}]}, {"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint"}]}, {"@id": "https://vocab.eona-x.eu/datex-ii/ElectricVehicleChargingPoint", "http://www.w3.org/2004/02/skos/core#closeMatch": [{"@id": "https://vocab.eona-x.eu/netex/ElectricVehicleChargingEquipment"}]}, {"@id": "https://vocab.eona-x.eu/alignments/netex-datex-ii", "http://www.w3.org/2000/01/rdf-schema#seeAlso": [{"@id": "https://vocab.eona-x.eu/netex/ev-charging"}, {"@id": "https://vocab.eona-x.eu/datex-ii/energy-infrastructure"}], "http://rdfs.org/ns/void#linkPredicate": [{"@id": "http://www.w3.org/2004/02/skos/core#relatedMatch"}, {"@id": "http://www.w3.org/2004/02/skos/core#closeMatch"}, {"@id": "http://www.w3.org/2004/02/skos/core#exactMatch"}], "http://purl.org/dc/terms/source": [{"@value": "Hub-curated EV-charging crosswalk for the EMDS demo (demo point C); not derived from an upstream NeTEx/DATEX II distribution — DATEX II and NeTEx are published natively as XSD and carry no canonical cross-standard SKOS mapping."}], "http://purl.org/dc/terms/creator": [{"@value": "EONA-X Vocabulary Hub"}], "http://purl.org/dc/terms/modified": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-26"}], "http://purl.org/dc/terms/created": [{"@type": "http://www.w3.org/2001/XMLSchema#date", "@value": "2026-06-22"}], "http://purl.org/dc/terms/description": [{"@value": "Hub-curated EV-charging (IRVE) crosswalk for the EMDS demo: SKOS alignment between the DATEX II EnergyInfrastructure subset (#433) and the NeTEx/Transmodel-style subset (#445), so a term in one vocabulary resolves to its counterpart in the other."}], "http://www.w3.org/2000/01/rdf-schema#label": [{"@value": "NeTEx ↔ DATEX II crosswalk (EV-charging)"}], "http://purl.org/dc/terms/title": [{"@value": "NeTEx ↔ DATEX II crosswalk (EV-charging)"}], "http://purl.org/dc/terms/identifier": [{"@value": "netex-datex-ii"}], "@type": ["http://www.w3.org/ns/dcat#Resource", "http://rdfs.org/ns/void#Linkset", "http://www.w3.org/2004/02/skos/core#ConceptScheme"]}]